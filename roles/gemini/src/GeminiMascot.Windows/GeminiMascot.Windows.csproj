<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <AssemblyName>AIMascot.Gemini</AssemblyName>
    <RootNamespace>AIMascot.Gemini</RootNamespace>
    <ApplicationIcon>../../../../assets/pets/gemini/gemini.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.2.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../../../src/AIMascot.Core/AIMascot.Core.csproj" />
    <Resource Include="../../../../assets/pets/gemini/idle.png" Link="Assets/idle.png" />
    <Resource Include="../../../../assets/pets/gemini/closed.png" Link="Assets/closed.png" />
    <Resource Include="../../../../assets/pets/gemini/happy.png" Link="Assets/happy.png" />
    <Resource Include="../../../../assets/pets/gemini/gemini.ico" Link="Assets/gemini.ico" />
  </ItemGroup>
  <ItemGroup><Compile Include="../../../../platform/RuntimeStatus.cs" Link="Platform/RuntimeStatus.cs" /></ItemGroup>
  <ItemGroup><Compile Include="../../../../platform/TargetPaths.cs" Link="Platform/TargetPaths.cs" /></ItemGroup>
</Project>
